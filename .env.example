# Copy to .env for local development.
# On Railway/VPS, set these in the environment variables panel or systemd/PM2 env.

TRONX_ADMIN_EMAIL=admin@tronx.vn
TRONX_ADMIN_PASSWORD=admin123

# Preferred production storage. When DATABASE_URL is set, users, OTPs, imports and analytics records use PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Fallback server-side file storage for dev only when DATABASE_URL is not set.
TRONX_DATA_DIR=.runtime-data

# Signed httpOnly login cookie.
AUTH_SECRET=change-me-to-a-long-random-secret
SESSION_TTL_SECONDS=86400

# SMTP mail for register/reset-password OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TronX <no-reply@tronx.vn>"

# Gemini REST API. Either GEMINI_API_KEY or GOOGLE_API_KEY works.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
